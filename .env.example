# OMOP_HOME — lokasi data runtime pengguna, default ~/.omop
OMOP_HOME=

# Master key secret store. Kalau kosong, key dibuat otomatis di OMOP_HOME/secret.key
OMOP_MASTER_KEY=

# Provider bawaan
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
# Daftar from.id pemilik, dipisah koma. Kosongkan kalau pairing lewat CLI.
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=

# Jaringan keluar (opsional)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
